# Server Configuration
PORT=3000
NODE_ENV=development

# Database Connection Settings (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USER=your_postgres_user
DB_PASSWORD=your_postgres_password
DB_NAME=autoscrap

# Prisma Database Connection URL
DATABASE_URL="postgresql://your_postgres_user:your_postgres_password@localhost:5432/autoscrap?schema=public"

# Authentication & Security (Generate a strong random string in production)
JWT_SECRET="your_jwt_secret_key_change_in_production"

# Vehicle Data Global API Key
VDG_API_KEY="your_vdg_api_key_here"
VEHICLE_DATA_GLOBAL_API_KEY="your_vehicle_data_global_api_key_here"

# SMTP Email Configuration
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=notifications@myautoscrap.co.uk
EMAIL_FROM_NAME="AutoScrap"

