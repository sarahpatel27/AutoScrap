# Frontend Environment Variables Template (Vite / Netlify Functions)
# NOTE: Variables prefixed with VITE_ are accessible in client browser code.
# Server-side variables (like VDG_API_KEY) are read securely by serverless functions / backend.

# Base URL for Backend API
VITE_API_BASE_URL=http://localhost:3000

# App Environment Mode
VITE_APP_ENV=development

