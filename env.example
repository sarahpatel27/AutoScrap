# Copy to .env in the project root, then: docker compose up -d --build
#   cp env.example .env

# --- Docker / Postgres ---
POSTGRES_USER=autoscrap
# Use letters, numbers, and dashes only (no @ : / #) so the DB URL stays valid.
POSTGRES_PASSWORD=change-me-to-a-strong-password
POSTGRES_DB=autoscrap

# Public hostnames Caddy will serve (website + /api + /uploads).
# Include both apex and www. Each name needs a DNS A record to the Lightsail IP.
DOMAIN=myautoscrap.co.uk, www.myautoscrap.co.uk
# Let's Encrypt rejects addresses like admin@localhost (the domain must contain a dot).
ACME_EMAIL=admin@myautoscrap.co.uk

# Leave empty so the browser calls /api and /uploads on the same domain (Caddy proxies to the API).
VITE_API_BASE_URL=

# --- API ---
NODE_ENV=production
PORT=3000
JWT_SECRET=replace-with-openssl-rand-hex-32

# Browser origins allowed to call the API. Match the public site URLs.
CORS_ORIGIN=https://myautoscrap.co.uk,https://www.myautoscrap.co.uk

# --- Email (Hostinger SMTP) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=notifications@myautoscrap.co.uk
EMAIL_FROM_NAME=AutoScrap

# --- Vehicle Data Global ---
VDG_API_KEY=
VDG_API_URL=https://uk.api.vehicledataglobal.com/r2/lookup

# --- Bidding ---
BIDDING_DURATION_HOURS=48
