{
	email {$ACME_EMAIL}
}

myautoscrap.co.uk {
	redir https://www.myautoscrap.co.uk{uri} permanent
}

www.myautoscrap.co.uk {
	encode gzip

	request_body {
		max_size 50MB
	}

	handle /api* {
		reverse_proxy api:3000
	}

	handle /uploads* {
		reverse_proxy api:3000
	}

	@cityPage path_regexp city ^/areas-we-cover/([a-zA-Z0-9_-]+)/?$
	handle @cityPage {
		forward_auth api:3000 {
			uri /api/cities/validate-slug?slug={re.city.1}
			copy_headers X-Robots-Tag
		}
		reverse_proxy frontend:80
	}

	handle {
		reverse_proxy frontend:80
	}
}
